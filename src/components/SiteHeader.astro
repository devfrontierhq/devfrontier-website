---
import SiteMobileNav from "@/components/SiteMobileNav.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { Menu, X } from "lucide-react";
import { NAV_LINKS, SITE } from "@/data/site";
---

<header class="sticky top-0 z-50" data-site-header>
  <div class="mx-auto flex min-h-18 max-w-360 items-center justify-between gap-4 px-4 py-2 sm:px-6 lg:px-10">
    <a
      href="/"
      class="shrink-0 rounded-md text-xl font-semibold tracking-tight text-foreground outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
    >
      {SITE.name}
    </a>
    <nav class="flex items-center gap-1 sm:gap-2">
      <div class="hidden items-center gap-1 md:flex lg:gap-2">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="shrink-0 px-2 py-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground lg:px-3"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <button
        type="button"
        class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background md:hidden"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">開啟選單</span>
        <Menu className="size-5" data-mobile-nav-icon="open" aria-hidden />
        <X className="size-5" data-mobile-nav-icon="close" aria-hidden />
      </button>
      <ThemeToggle />
    </nav>
  </div>

  <SiteMobileNav />
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  if (header) {
    const update = () =>
      header.toggleAttribute("data-scrolled", window.scrollY > 8);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
