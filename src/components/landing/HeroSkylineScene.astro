---
/** 台北剪影 + SVG 弧線 */
---

<div class="hero-skyline-scene">
  <div class="hero-skyline-grid" aria-hidden="true"></div>

  <svg
    class="hero-skyline-arcs"
    viewBox="0 0 960 320"
    preserveAspectRatio="xMidYMax meet"
    aria-hidden="true"
  >
    <path class="hero-skyline-arc" d="M 48 248 C 180 108, 320 88, 468 132" />
    <path class="hero-skyline-arc hero-skyline-arc-b" d="M 468 132 C 580 52, 720 72, 912 210" />
    <path class="hero-skyline-arc hero-skyline-arc-c" d="M 120 268 C 260 168, 420 148, 640 188" />
  </svg>

  <div class="hero-skyline-layers">
    <img
      src="/hero-skyline.png"
      alt=""
      width={1582}
      height={443}
      loading="eager"
      decoding="async"
      class="hero-skyline"
    />
  </div>

  <div class="hero-skyline-tags" aria-hidden="true">
    <span class="hero-skyline-tag hero-skyline-tag--community">Community</span>
    <span class="hero-skyline-tag hero-skyline-tag--js">JavaScript</span>
    <span class="hero-skyline-tag hero-skyline-tag--ai">AI</span>
  </div>
</div>

<style>
  .hero-skyline-scene {
    position: relative;
    width: 100%;
    flex-shrink: 0;
    min-height: min(40vh, 300px);
    isolation: isolate;
  }

  .hero-skyline-scene::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 4;
    height: 20%;
    pointer-events: none;
    background: linear-gradient(to top, var(--background) 0%, transparent 100%);
  }

  .hero-skyline-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    background-image:
      linear-gradient(oklch(1 0 0 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, oklch(1 0 0 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 60%, #000 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 60%, #000 0%, transparent 75%);
  }

  :global(.dark) .hero-skyline-grid {
    opacity: 0.55;
  }

  .hero-skyline-arcs {
    position: absolute;
    inset: 0 0 6%;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
  }

  :global(.dark) .hero-skyline-arcs {
    opacity: 0.9;
  }

  .hero-skyline-arc {
    fill: none;
    stroke: var(--primary);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .hero-skyline-arc-b,
  .hero-skyline-arc-c {
    stroke-width: 1.25;
    opacity: 0.8;
  }

  .hero-skyline-layers {
    position: relative;
    z-index: 2;
    width: 100%;
    height: min(40vh, 300px);
    overflow: hidden;
    mask-image:
      linear-gradient(to bottom, transparent 0%, black 18%, black 100%),
      linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0%, black 18%, black 100%),
      linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-composite: destination-in;
  }

  .hero-skyline {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    object-position: center bottom;
    filter: brightness(0) saturate(100%);
    opacity: 0.2;
    mix-blend-mode: multiply;
  }

  :global(.dark) .hero-skyline {
    mix-blend-mode: normal;
    opacity: 0.55;
    filter:
      brightness(0) saturate(100%) invert(59%) sepia(60%) saturate(500%) hue-rotate(162deg)
      brightness(1.0)
      drop-shadow(0 0 8px oklch(0.62 0.14 230 / 0.25))
      drop-shadow(0 0 18px oklch(0.62 0.14 230 / 0.12));
  }

  .hero-skyline-tags {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .hero-skyline-tag {
    position: absolute;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    border: 1px solid;
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
    white-space: nowrap;
  }

  :global(.dark) .hero-skyline-tag {
    opacity: 1;
    animation: skyline-tag-float 4s ease-in-out infinite;
  }

  .hero-skyline-tag--community {
    left: 8%;
    bottom: 28%;
    color: oklch(0.82 0.22 340);
    border-color: oklch(0.72 0.22 340 / 0.7);
    background: oklch(0.18 0.08 340 / 0.6);
    box-shadow: 0 0 14px oklch(0.58 0.24 330 / 0.4), inset 0 0 8px oklch(0.58 0.24 330 / 0.1);
    animation-delay: 0s;
  }

  .hero-skyline-tag--js {
    left: 32%;
    top: 16%;
    color: oklch(0.82 0.14 210);
    border-color: oklch(0.72 0.14 220 / 0.7);
    background: oklch(0.18 0.06 230 / 0.6);
    box-shadow: 0 0 14px oklch(0.62 0.14 230 / 0.4), inset 0 0 8px oklch(0.62 0.14 230 / 0.1);
    animation-delay: -1.4s;
  }

  .hero-skyline-tag--ai {
    right: 12%;
    top: 32%;
    color: oklch(0.82 0.18 300);
    border-color: oklch(0.72 0.2 310 / 0.7);
    background: oklch(0.18 0.08 300 / 0.6);
    box-shadow: 0 0 14px oklch(0.62 0.2 310 / 0.4), inset 0 0 8px oklch(0.62 0.2 310 / 0.1);
    animation-delay: -2.7s;
  }

  .hero-skyline-label {
    position: absolute;
    right: clamp(0.5rem, 4vw, 2rem);
    bottom: 0.4rem;
    z-index: 5;
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    text-transform: uppercase;
    color: oklch(0.58 0.04 260);
    opacity: 1;
  }

  :global(.dark) .hero-skyline-label {
    color: oklch(0.88 0.06 250);
  }

  @media (min-width: 768px) {
    .hero-skyline-scene { min-height: min(44vh, 420px); width: 100%; }
    .hero-skyline-layers { height: min(44vh, 420px); }
  }

  @media (min-width: 1024px) {
    .hero-skyline-scene { min-height: min(48vh, 460px); }
    .hero-skyline-layers { height: min(48vh, 460px); }
  }
</style>

<script>
  import { gsap } from "gsap";

  gsap.from(".hero-skyline-arc", {
    strokeDasharray: (_, el: SVGPathElement) => el.getTotalLength(),
    strokeDashoffset: (_, el: SVGPathElement) => el.getTotalLength(),
    duration: 1.2,
    stagger: 0.2,
    ease: "power2.out",
    delay: 0.3,
  });
</script>
