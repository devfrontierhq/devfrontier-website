<span class="header-logo3d" data-header-logo3d aria-hidden="true">
  <canvas class="header-logo3d__canvas"></canvas>
</span>

<script>
  import * as THREE from "three";
  import { SVGLoader } from "three/examples/jsm/loaders/SVGLoader.js";
  import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";

  const EXTRUDE = {
    depth: 26,
    bevelEnabled: true,
    bevelThickness: 3,
    bevelSize: 2.2,
    bevelSegments: 4,
    curveSegments: 16,
  };

  function applyGradient(
    geo: THREE.BufferGeometry,
    axis: "x" | "y",
    cLo: string,
    cHi: string,
  ) {
    geo.computeBoundingBox();
    const bb = geo.boundingBox!;
    const lo = axis === "x" ? bb.min.x : bb.min.y;
    const hi = axis === "x" ? bb.max.x : bb.max.y;
    const span = hi - lo || 1;
    const a = new THREE.Color(cLo).convertSRGBToLinear();
    const b = new THREE.Color(cHi).convertSRGBToLinear();
    const tmp = new THREE.Color();
    const pos = geo.attributes.position;
    const colors = new Float32Array(pos.count * 3);
    for (let i = 0; i < pos.count; i++) {
      const v = axis === "x" ? pos.getX(i) : pos.getY(i);
      const t = Math.min(1, Math.max(0, (v - lo) / span));
      tmp.copy(a).lerp(b, t);
      colors[i * 3] = tmp.r;
      colors[i * 3 + 1] = tmp.g;
      colors[i * 3 + 2] = tmp.b;
    }
    geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));
  }

  async function buildPart(
    loader: SVGLoader,
    material: THREE.Material,
    url: string,
    axis: "x" | "y",
    cLo: string,
    cHi: string,
  ): Promise<THREE.Group> {
    const svgText = await fetch(url).then((r) => r.text());
    const data = loader.parse(svgText);
    const group = new THREE.Group();
    for (const path of data.paths) {
      for (const shape of SVGLoader.createShapes(path)) {
        const geo = new THREE.ExtrudeGeometry(shape, EXTRUDE);
        applyGradient(geo, axis, cLo, cHi);
        group.add(new THREE.Mesh(geo, material));
      }
    }
    return group;
  }

  async function setup(host: HTMLElement) {
    const canvas = host.querySelector("canvas") as HTMLCanvasElement;
    if (!canvas) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(0, 0, 9);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    scene.add(new THREE.AmbientLight(0xffffff, 0.5));
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(-4, 6, 6);
    scene.add(key);
    const rimPurple = new THREE.DirectionalLight(0xb15cff, 2.2);
    rimPurple.position.set(6, -2, -4);
    scene.add(rimPurple);
    const rimBlue = new THREE.DirectionalLight(0x3aa0ff, 1.5);
    rimBlue.position.set(-6, -3, 2);
    scene.add(rimBlue);

    const material = new THREE.MeshPhysicalMaterial({
      vertexColors: true,
      metalness: 0.35,
      roughness: 0.28,
      clearcoat: 0.7,
      clearcoatRoughness: 0.25,
      envMapIntensity: 1.15,
    });

    const fit = new THREE.Group();
    scene.add(fit);

    const loader = new SVGLoader();
    const [blue, pink] = await Promise.all([
      buildPart(loader, material, "/logo3d/blue.svg", "y", "#5fc4f9", "#2fb4f7"),
      buildPart(loader, material, "/logo3d/pink.svg", "x", "#db429d", "#a948e9"),
    ]);

    const logo = new THREE.Group();
    logo.add(blue, pink);
    logo.scale.y = -1;
    const box = new THREE.Box3().setFromObject(logo);
    const center = box.getCenter(new THREE.Vector3());
    const size = box.getSize(new THREE.Vector3());
    logo.position.sub(center);
    fit.add(logo);

    function layout() {
      const w = host.clientWidth || 1;
      const h = host.clientHeight || 1;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();

      // canvas is square, so visible height == width; size to the larger
      // logo dimension so the whole mark fits.
      const visH =
        2 * Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2) * camera.position.z;
      const targetMax = visH * 0.92;
      fit.scale.setScalar(targetMax / Math.max(size.x, size.y));

      if (reduce) renderer.render(scene, camera);
    }
    new ResizeObserver(layout).observe(host);
    layout();

    if (reduce) return; // static render handled in layout()

    // pause the render loop while the header is scrolled out of view
    let visible = true;
    new IntersectionObserver(
      (entries) => (visible = entries[0].isIntersecting),
      { threshold: 0.01 },
    ).observe(host);

    const clock = new THREE.Clock();
    function frame() {
      requestAnimationFrame(frame);
      if (!visible) return;
      const t = clock.getElapsedTime();
      fit.position.y = Math.sin(t * 1.2) * 0.1; // tiny bob
      fit.rotation.y = t * 1.1; // continuous 360° spin
      renderer.render(scene, camera);
    }
    frame();
  }

  document
    .querySelectorAll<HTMLElement>("[data-header-logo3d]")
    .forEach(setup);
</script>

<style>
  .header-logo3d {
    display: inline-block;
    width: 2.25rem;
    height: 2.25rem;
    pointer-events: none;
    vertical-align: middle;
  }
  @media (min-width: 640px) {
    .header-logo3d {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
  .header-logo3d__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
