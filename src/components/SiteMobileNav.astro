---
import { NAV_LINKS } from "@/data/site";
---

<div
  id="mobile-nav"
  class="hidden border-t border-border/80 bg-background/95 backdrop-blur-md md:hidden"
  data-mobile-nav
  aria-hidden="true"
>
  <div class="mx-auto max-w-[90rem] px-4 py-4 sm:px-6 lg:px-10">
    <ul class="flex flex-col gap-1">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import { initMobileNav } from "@/lib/mobile-nav";

  initMobileNav();
</script>
