---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/common/BrandLogo";
import { SITE, ABOUT_PARAGRAPHS } from "@/data/site";
import { ABOUT_PILLARS, ABOUT_GOALS } from "@/data/about";
---

<BaseLayout title="關於我們" description={SITE.intro}>
  <section class="landing-section">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <div class="mb-8 flex justify-center" data-aos="fade-up">
        <BrandLogo />
      </div>
      <div class="space-y-4 text-left text-lg leading-relaxed text-muted-foreground" data-aos="fade-up" data-aos-delay="100">
        {ABOUT_PARAGRAPHS.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="landing-section border-t border-border bg-muted/15">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight sm:text-3xl" data-aos="fade-up">
        核心理念
      </h2>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {ABOUT_PILLARS.map((pillar, i) => (
          <li class="flex min-h-18 items-center justify-center rounded-lg border border-primary bg-primary/[0.07] px-3 py-5 text-center text-sm font-semibold text-primary dark:bg-primary/10" data-aos="fade-up" data-aos-delay={i * 70}>
            {pillar.label}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="landing-section border-t border-border">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight sm:text-3xl" data-aos="fade-up">
        我們的目標
      </h2>
      <ul class="grid gap-4 md:grid-cols-3">
        {ABOUT_GOALS.map((goal, i) => (
          <li class="card-hover group rounded-xl border border-border bg-card p-6" data-aos="fade-up" data-aos-delay={i * 100}>
            <span class="mb-3 block text-[2.5rem] font-bold leading-none text-primary opacity-[0.18] transition-[opacity,text-shadow] duration-300 group-hover:opacity-[0.32] group-hover:[text-shadow:0_0_20px_oklch(0.62_0.14_230/0.2)] dark:group-hover:[text-shadow:0_0_20px_oklch(0.75_0.14_220/0.3)]" aria-hidden="true">{goal.index}</span>
            <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">{goal.phase}</p>
            <p class="text-sm leading-relaxed text-muted-foreground">{goal.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
