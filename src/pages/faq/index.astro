---
import FaqAccordion from "@/components/FaqAccordion";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FAQ_ITEMS } from "@/data/faq";
import { SITE } from "@/data/site";

---

<BaseLayout title="常見問題" description={SITE.name}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <header class="mb-10 text-center">
      <h1 class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl">常見問題</h1>
    </header>
    <FaqAccordion client:visible items={FAQ_ITEMS} />
  </section>
</BaseLayout>
